{
  "name": "dsh-turbo",
  "version": "1.4.1",
  "description": "Agent speed pack: batch multi-file reads with glob support, one-call workspace maps, parallel subagent planner, forced low reasoning effort while enabled, and a composer Turbo toggle",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "speed",
    "batch",
    "subagent",
    "parallel",
    "reasoning-effort"
  ],
  "author": "xzdes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzdes/dsh-turbo.git"
  },
  "homepage": "https://github.com/xzdes/dsh-turbo#readme",
  "bugs": "https://github.com/xzdes/dsh-turbo/issues",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}
